# Example environment configuration file for Usage Metering Service
# Copy this file to .env to configure settings for local development

# HTTP server port (integer between 1 and 65535, default: 3000)
PORT=3000

# Host address to bind the HTTP server (default: 127.0.0.1)
HOST=127.0.0.1

# PostgreSQL connection string for local development (default dev port: 5433)
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Note: When connecting to Docker Compose PostgreSQL on the host, use port 5434
DATABASE_URL=postgres://postgres:postgres_password@127.0.0.1:5433/usage_metering_dev
