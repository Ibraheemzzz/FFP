# مثال لملف الإعدادات والبيئة للمشروع
# انسخ هذا الملف إلى .env لتعديل الإعدادات محلياً

# منفذ تشغيل الخادم (عدد صحيح بين 1 و 65535، الافتراضي: 3000)
PORT=3000

# عنوان المضيف للاستماع لطلبات الشبكة (الافتراضي: 127.0.0.1)
HOST=127.0.0.1

# رابط الاتصال بقاعدة بيانات PostgreSQL المخصصة للمشروع عبر Docker Compose (المنفذ 5433)
# الصيغة: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:postgres_password@127.0.0.1:5433/usage_metering_dev
